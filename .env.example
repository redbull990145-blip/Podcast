# Copy to .env and fill in. Never commit .env.
# Every value here is obtainable on a free tier.

# ---- Database (Supabase → Project Settings → Database → Connection string) ----
# Use the "Session"/direct connection string for migrations. Include ?sslmode=require.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# ---- Redis (Upstash → Database → REST API) ----
# Used for feed caching, rate-limit counters, and recommendation caching only.
REDIS_URL=https://YOUR-DB.upstash.io
REDIS_TOKEN=

# ---- Podcast catalog (podcastindex.org/api — free registration) ----
# This is where search and discovery data comes from.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# ---- Email verification (resend.com — free tier, 100/day, no card) ----
# Optional, and it is the switch for the whole feature: with a key, sign-up
# emails a 6-digit code and an account cannot be used until it is entered;
# without one, verification is off and accounts work immediately. It is not
# left on with no way to send, because that locks every new account out of the
# app it just created.
RESEND_API_KEY=
# The From address. The default below is Resend's shared sandbox sender: it
# needs no DNS and works the moment a key exists, but it will ONLY deliver to
# the address that owns the Resend account — every other recipient is silently
# refused. Verify your own domain in Resend and set it here before real signups.
EMAIL_FROM=Cue <onboarding@resend.dev>

# Origins allowed to call this API from a browser, comma-separated. In
# production this is the web app's real origin — and it is load-bearing, not
# hygiene: the session cookie is SameSite=None there (the web app and the API
# are different registrable domains), so this allowlist is what stands between
# a malicious page and a request carrying the user's session.
CORS_ORIGINS=http://localhost:3000

# ---- Networking ----
# How many proxies sit in front of the API. Security-relevant: it decides which
# address rate limits are counted against, and getting it wrong in either
# direction is a real problem.
#
#   0  nothing in front — forwarding headers ignored entirely
#   1  one platform load balancer (Render, Koyeb, Fly) — the usual answer
#   2  Cloudflare in front of a platform load balancer
#
# Too high and a caller can forge the address by prepending their own
# X-Forwarded-For, which buys them unlimited retries of anything rate limited.
# Too low and every request appears to come from the load balancer, so the whole
# deployment shares one budget.
TRUST_PROXY_HOPS=1

# ---- AI: operator tier (console.groq.com — free tier) ----
# Optional. Without it, AI features require each user to add their own key.
GROQ_API_KEY=

# Encrypts user-supplied API keys at rest. MUST stay identical across deploys
# or stored BYOK keys become undecryptable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=

# Operator-funded AI requests per user per UTC day. Users with their own key
# are not counted against it.
AI_DAILY_QUOTA=20

# Whether this process also runs the transcription worker. Leave it on for a
# single-service deployment. Set it to `off` on the web service only when the
# worker runs as its own process (`npm run worker`), so the work happens in one
# place — a job holds a whole episode in memory, and on a small instance that is
# enough to take the API down with it.
TRANSCRIBE_WORKER=on

# ---- Client → API ----
NEXT_PUBLIC_API_URL=http://localhost:8080
# For a physical Android device this must be your machine's LAN IP, not
# localhost — the phone resolves localhost to itself.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Where the Android app points shared links. Shared episodes always open on the
# web, never on a cue:// scheme, so that a link works for someone who does not
# have the app. Falls back to EXPO_PUBLIC_API_URL when unset, which is wrong in
# production — set it to the web app's real origin.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
