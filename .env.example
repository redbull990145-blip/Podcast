# ---- Supabase (Phase 0) ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection for Drizzle migrations.
# Project Settings -> Database -> Connection string -> URI (use the pooler for runtime).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---- Podcast discovery (Phase 1) ----
# https://api.podcastindex.org — free, register for a key/secret.
# iTunes Search API needs no key.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# ---- AI: operator-funded default tier (Phase 3) ----
# Server-only. These are YOUR keys funding the free tier for all users.
# Dev: OpenRouter free models. Launch: DeepSeek.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Groq provides a free-tier Whisper endpoint for speech-to-text.
GROQ_API_KEY=

# Which provider the default tier uses: "openrouter" | "deepseek"
AI_DEFAULT_PROVIDER=openrouter

# Optional override for which OpenRouter free-variant models to try, in order,
# comma-separated. OpenRouter's free catalogue rotates and changes often — if
# generation fails with "model not found", open https://openrouter.ai/models,
# filter to free, click a model, copy its exact id (format org/name:free), and
# set this. Leave unset to use the built-in list in lib/ai/config.ts.
AI_OPENROUTER_MODELS=

# Per-user daily free quota for the operator-funded tier.
# Users who add their own key in Settings bypass these entirely.
AI_DAILY_FREE_JOBS=5
AI_DAILY_FREE_QA=20

# ---- Encryption for user-supplied BYOK keys (Phase 3) ----
# 32-byte key, base64. Generate: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=

# ---- Cloudflare Worker job runner (Phase 3) ----
AI_JOBS_WORKER_URL=
AI_JOBS_WORKER_SECRET=
