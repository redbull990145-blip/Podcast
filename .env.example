# Copy to .env and fill in. Never commit .env.
# Every value here is obtainable on a free tier.

# ---- Database (Supabase → Project Settings → Database → Connection string) ----
# Use the "Session"/direct connection string for migrations. Include ?sslmode=require.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# ---- Redis (Upstash → Database → REST API) ----
# Used for feed caching, rate-limit counters, and recommendation caching only.
REDIS_URL=https://YOUR-DB.upstash.io
REDIS_TOKEN=

# ---- Podcast catalog (podcastindex.org/api — free registration) ----
# This is where search and discovery data comes from.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# ---- AI: operator tier (console.groq.com — free tier) ----
# Optional. Without it, AI features require each user to add their own key.
GROQ_API_KEY=

# Encrypts user-supplied API keys at rest. MUST stay identical across deploys
# or stored BYOK keys become undecryptable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=

# ---- Client → API ----
NEXT_PUBLIC_API_URL=http://localhost:8080
# For a physical Android device this must be your machine's LAN IP, not
# localhost — the phone resolves localhost to itself.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
