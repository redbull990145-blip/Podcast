{
  "name": "cue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A podcast platform for web and Android",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.30.0",
    "sharp": "0.35.5",
    "proxy-addr": "2.0.8",
    "fast-uri@3": "3.1.8",
    "fast-uri@4": "4.1.5",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "@xmldom/xmldom@0.8": "0.8.15",
    "@xmldom/xmldom@0.9": "0.9.12",
    "compression": "1.8.2",
    "fast-copy": "4.1.0",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  }
}
