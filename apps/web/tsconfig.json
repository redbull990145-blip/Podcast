{
  // Relative path, not the package name: this must resolve by plain
  // filesystem lookup, not node_modules resolution, or a build tool that
  // traces/prunes devDependencies (@cue/config is one) before its own
  // type-check pass can silently fail to find it and fall back to bare
  // defaults — see apps/api/tsconfig.json for the incident this fixed.
  "extends": "../../packages/config/tsconfig/next.json",
  "compilerOptions": {
    // Restated rather than only inherited. An extends that fails to resolve
    // falls back to bare defaults *silently*, and bare defaults mean
    // `strict: false` — which disables narrowing of discriminated unions and
    // produces type errors in correct code. See apps/api/tsconfig.json for the
    // two build environments this actually happened in.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `.open-next` and `.wrangler` are build output and local Cloudflare state.
  // They have to be named here because the `include` above is a bare `**/*.ts`
  // glob, which would otherwise pull generated sources into the type-check and
  // report errors in code nobody wrote.
  "exclude": ["node_modules", ".open-next", ".wrangler"]
}
