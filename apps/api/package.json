{
  "name": "@cue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker-main.ts",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "backfill:colors": "tsx --env-file-if-exists=../../.env src/backfill-colors.ts"
  },
  "devDependencies": {
    "@cue/config": "*",
    "@electric-sql/pglite": "latest",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@cue/core": "*",
    "@cue/db": "*",
    "@cue/design": "*",
    "@cue/i18n": "*",
    "@cue/types": "*",
    "@cue/validation": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vibrant/color": "^4.0.4",
    "@vibrant/core": "^4.0.4",
    "@vibrant/generator-default": "^4.0.4",
    "@vibrant/image": "^4.0.4",
    "@vibrant/quantizer-mmcq": "^4.0.4",
    "better-auth": "^1.6.27",
    "fast-xml-parser": "^5.10.1",
    "fastify": "5.12.5",
    "sanitize-html": "^2.17.7",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "zod": "^4.4.3"
  }
}
