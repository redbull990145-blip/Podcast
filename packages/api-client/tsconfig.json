{
  // Relative path, not the package name: this must resolve by plain
  // filesystem lookup, not node_modules resolution, or a build tool that
  // traces/prunes devDependencies (@cue/config is one) before its own
  // type-check pass can silently fail to find it and fall back to bare
  // defaults — see apps/api/tsconfig.json for the incident this fixed.
  "extends": "../../packages/config/tsconfig/library.json",
  "compilerOptions": {
    // This package targets any runtime with `fetch` — a browser, React
    // Native's polyfill, or Node. The DOM lib is where those types live; it is
    // not a claim that this code touches the document.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
